# ====================================================================
# MPLAB X / Microchip Development Gitignore Template
# ====================================================================

# Object and compiled binary output files
*.o
*.ko
*.obj
*.elf
*.hex
*.cof

# Local build and distribution directories
build/
dist/
disassembly/
.generated_files/

# MPLAB X / NetBeans internal build structures 
nbproject/build/
nbproject/dist/
nbproject/disassembly/

# CRITICAL: Ignore local user machine paths/settings
# This prevents breaking the build on other people's computers
private/
nbproject/private/

# Backup folders generated by MPLAB Code Configurator (MCC)
mcc_backup/
.mcc/

# Editor backup files and logs
~*.*
*.log
*.inx
*.p1
*.d
